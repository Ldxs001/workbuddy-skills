{
  "id": "make_product_ppt_v1",
  "type": "capability",
  "name": "制作产品介绍PPT",
  "version": "1.0.0",
  "created_at": "2026-05-22",
  "description": "从零制作一份产品介绍PPT的完整步骤，通用化版本。适用于需要向受众展示某产品的功能、卖点、研发背景等场景。",
  "generic_params": ["[产品名称]", "[核心参数]", "[截止时间]", "[目标格式]", "[目标受众]"],
  "steps": [
    {
      "id": "s1",
      "name": "收集产品资料",
      "action": "搜索/整理[产品名称]相关资料，包括[核心参数]、市场定位、竞品对比等",
      "parallel_group": null,
      "milestone": true,
      "dependency_heat": 0,
      "depends_on": []
    },
    {
      "id": "s2",
      "name": "提炼核心卖点与故事",
      "action": "从资料中提炼[产品名称]的核心卖点、研发故事、差异化优势",
      "parallel_group": null,
      "milestone": true,
      "dependency_heat": 9,
      "depends_on": ["s1"]
    },
    {
      "id": "s3",
      "name": "设计PPT大纲与章节",
      "action": "规划封面、产品介绍、核心卖点、研发故事、总结等章节结构，考虑[目标受众]偏好",
      "parallel_group": null,
      "milestone": true,
      "dependency_heat": 8,
      "depends_on": ["s2"]
    },
    {
      "id": "s4a",
      "name": "制作内容页",
      "action": "填充各章节正文内容，确保信息准确、卖点突出",
      "parallel_group": "pg1",
      "milestone": false,
      "dependency_heat": 7,
      "depends_on": ["s3"]
    },
    {
      "id": "s4b",
      "name": "设计视觉风格",
      "action": "确定配色方案、字体选择、模板风格，确保与[产品名称]调性一致",
      "parallel_group": "pg1",
      "milestone": false,
      "dependency_heat": 5,
      "depends_on": ["s3"]
    },
    {
      "id": "s5",
      "name": "审核修改",
      "action": "检查内容准确性、视觉一致性、卖点突出度，修正问题",
      "parallel_group": null,
      "milestone": true,
      "dependency_heat": 7,
      "depends_on": ["s4a", "s4b"]
    },
    {
      "id": "s6",
      "name": "导出PPT",
      "action": "导出为[目标格式]，确保在[截止时间]前完成",
      "parallel_group": null,
      "milestone": false,
      "dependency_heat": 3,
      "depends_on": ["s5"]
    }
  ],
  "tags": ["ppt", "内容制作", "产品介绍"]
}
