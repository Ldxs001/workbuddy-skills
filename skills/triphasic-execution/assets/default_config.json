{
  "enabled": true,
  "settings_ui_enabled": true,
  "_triphasic_home": "skills/.standardization/triphasic-execution/data/",
  "mode": "on_demand",
  "logs_dir": ".problem_logs",
  "exec_pipe": ".exec_output_pipe.txt",
  "problems_file": "PROBLEMS.md",
  "risks_file": "RISKS.md",
  "lessons_file": "LESSONS_REGISTER.md",
  "poll_interval_ms": 100,
  "error_patterns": [
    "error|Error|ERROR",
    "exception|Exception|EXCEPTION",
    "failed|Failed|FAILED",
    "traceback|Traceback",
    "拒绝|失败|错误|异常"
  ],
  "auto_resolve_timeout_hours": 24,
  "daemon": {
    "enabled": false,
    "start_on_boot": false
  },
  "hooks": {
    "pre_exec_search": true,
    "auto_record_exception": true,
    "require_task_confirmation": true
  }
}
