  "required_sections": [
    {
      "heading_level": 1,
      "pattern": "# <技能名>",
      "description": "一级标题：技能名称，可加 — 简短副标题，不得含版本号",
      "example": "# git-sync — 三端同步技能",
      "constraint": "全文必须有且仅有一个 # 标题；R-25 C-01 (ERROR)",
      "tier": "must_have",
      "content_format": {
        "type": "plain",
        "template": "# <技能名> [— 简短副标题]",
        "guidelines": "仅含技能名和可选的副标题，不得含版本号（版本号由 frontmatter version 管理）"
      }
    },
    {
      "heading_level": 2,
      "keywords": [
        "触发条件",
        "触发场景",
        "适用场景",
        "触发"
      ],
      "alias_pattern": "## 触发条件 / ## 触发场景 / ## 适用场景 等",
      "description": "描述何时应调用此技能，可含 ## 否定条件 子章节",
      "constraint": "必须存在，可用同义词变体",
      "tier": "must_have",
      "content_format": {
        "type": "mixed",
        "template": "**正向触发：**\n- 条件1\n- 条件2\n\n**否定条件：**\n- 条件1\n- 条件2",
        "guidelines": "分正向触发和否定条件两个子列表。正向触发用无序列表列出触发此技能的明确场景；否定条件用无序列表列出不应触发此技能的场景。每项用短语描述即可。",
        "classification_hints": {
          "preferred_name": "触发条件",
          "content_patterns": [
            "触发",
            "调用",
            "否定",
            "不触发"
          ],
          "format_clues": [
            "正向触发",
            "否定条件"
          ],
          "llm_guidance": "描述何时调用、何时不调用。如发现内容属于条件描述但章节名是其他名称，建议合并到此章节。"
        }
      }
    },
    {
      "heading_level": 2,
      "keywords": [
        "核心功能",
        "核心能力",
        "概述",
        "核心概念",
        "Overview",
        "技能概述"
      ],
      "alias_pattern": "## 核心功能 / ## 概述 / ## Overview 等",
      "description": "列出技能的核心能力（用表格），末尾放置渐进式索引表",
      "constraint": "必须存在，可用同义词变体",
      "tier": "must_have",
      "content_format": {
        "type": "table",
        "table_columns": [
          "#",
          "能力",
          "说明"
        ],
        "guidelines": "必须用表格，三列：#编号、能力名（加粗）、说明。每行一个独立能力。表格前应有渐进式加载模板句（R-21 要求）。章节末尾放置渐进式索引表（### 渐进式文件索引），列出所有 references/ 文件。",
        "example": "| # | 能力 | 说明 |\n|---|------|------|\n| 1 | **能力一** | 能力一描述 |\n| 2 | **能力二** | 能力二描述 |",
        "classification_hints": {
          "preferred_name": "核心能力",
          "content_patterns": [
            "能力",
            "功能",
            "支持"
          ],
          "format_clues": [
            "表格",
            "加粗"
          ],
          "llm_guidance": "列出技能的核心能力表格。如发现内容属于功能列表但未用表格，需转换为表格格式。"
        }
      }
    },
    {
      "heading_level": 2,
      "keywords": [
        "约束"
      ],
      "alias_pattern": "## 约束",
      "description": "本技能的特定操作约束，必须阅读后再使用",
      "constraint": "must_have，永远留在 SKILL.md",
      "tier": "must_have",
      "content_format": {
        "type": "unordered_list",
        "guidelines": "用无序列表，每条约束一句话，最多 5 条。每条必须简练、可执行，不能有模糊表述。长段规则说明应放在 references/ 或归入强制约束章节。",
        "example": "- 技能文件修改必须通过 Python 脚本原子写入\n- 更新后必须运行 audit 自审\n- 版本号三端一致",
        "classification_hints": {
          "preferred_name": "约束",
          "content_patterns": [
            "必须",
            "禁止",
            "不得",
            "只能",
            "约束",
            "铁律"
          ],
          "format_clues": [
            "简短列表",
            "一行一条"
          ],
          "llm_guidance": "本技能特有的简短操作约束，每条一句话。如发现内容属于操作规则但章节名不同，建议合并到约束。与强制约束的区别：约束是简短清单（≤5条），强制约束是详细表格。"
        }
      }
    }
  ],
